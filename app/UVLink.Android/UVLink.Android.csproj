<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>fr.f4dvk.uvlink</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!-- rtl_433 pour l'onglet ISM : exécutables statiques produits par tools/build_rtl433_android.sh
       (NDK), nommés lib*.so pour être livrés dans lib/<abi>/ de l'APK et extraits dans nativeLibraryDir -->
  <ItemGroup>
    <AndroidNativeLibrary Include="native\arm64-v8a\librtl_433.so" Condition="Exists('native\arm64-v8a\librtl_433.so')" />
    <AndroidNativeLibrary Include="native\armeabi-v7a\librtl_433.so" Condition="Exists('native\armeabi-v7a\librtl_433.so')" />
    <AndroidNativeLibrary Include="native\x86_64\librtl_433.so" Condition="Exists('native\x86_64\librtl_433.so')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UVLink\UVLink.csproj" />
  </ItemGroup>
</Project>
